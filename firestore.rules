rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 已登入、Email 已驗證，且在 members 名單內
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email.lower()));
    }

    function memberRole() {
      return get(/databases/$(database)/documents/members/$(request.auth.token.email.lower())).data.role;
    }

    // 管理者或主管
    function isManager() {
      return isMember() && memberRole() in ['admin', 'supervisor'];
    }

    function isAdmin() {
      return isMember() && memberRole() == 'admin';
    }

    match /members/{email} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /records/{id} {
      allow read, write: if isMember();
    }

    match /config/{id} {
      allow read, write: if isMember();
    }

    // docs：人員招募・薪資資料（docs_staff 開頭）只有管理者與主管可讀寫，其餘文件所有成員可讀寫
    match /docs/{id} {
      allow read, write: if (isMember() && !id.matches('docs_staff_.*'))
                         || (isManager() && id.matches('docs_staff_.*'));
    }

    // kv：一般資料所有成員可讀寫；
    // 課程內容（ccEdits 開頭）與值班表（duty 開頭：人員、國定假日、開始日期）只有管理者與主管可寫
    match /kv/{id} {
      allow read: if isMember();
      allow write: if (isMember() && !id.matches('(ccEdits|duty).*'))
                   || (isManager() && id.matches('(ccEdits|duty).*'));
    }

    // 請假交接單 leaves：
    // 一般成員只能看、改自己建立的假單，且只能在「草稿」時修改；送出後唯讀
    // 管理者與主管可看全部；「已閱」由管理者與主管標示
    match /leaves/{id} {
      allow read: if isManager()
                  || (isMember() && resource.data.owner == request.auth.token.email.lower());
      allow create: if isMember()
                    && request.resource.data.owner == request.auth.token.email.lower();
      allow update: if isManager()
                    || (isMember()
                        && resource.data.owner == request.auth.token.email.lower()
                        && resource.data.status == '草稿'
                        && request.resource.data.owner == request.auth.token.email.lower());
      allow delete: if isAdmin();
    }
  }
}
